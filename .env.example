DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres   # local: supabase start (puerto 54322). Prod/staging: Supavisor transaction mode (puerto 6543)
# El rol de conexión debe poder `SET ROLE authenticated` (RLS real por transacción).
# Local: el rol `postgres` de supabase start ya puede hacerlo. Hosted: GRANT authenticated TO <rol>.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWKS_URL=${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=
JWT_AUDIENCE=authenticated
ENVIRONMENT=dev
SENTRY_DSN=
# Orígenes exactos del front, coma-separados (además de localhost:5173/3000
# y *.vercel.app, que ya se permiten solo en ENVIRONMENT=dev sin configurar
# nada acá). En prod es OBLIGATORIO — sin esto, CORS bloquea todo.
CORS_ALLOW_ORIGINS=
# URL pública del front, sin `/` final. Con ella se arman los enlaces de
# invitación y de «Generar enlace» (`/auth/callback?token_hash=…`). Sin ella,
# la invitación por correo vuelve al correo de Supabase (NOTIFICACIONES §16).
FRONTEND_URL=
# Correo saliente por Resend (docs/NOTIFICACIONES.md). Vacío = no sale ningún
# correo: las entregas quedan `skipped_no_provider` y el job nocturno sigue; la
# invitación de usuario vuelve al correo de Supabase (§16). Tiene que estar en
# la app del API, no solo en el job: la invitación sale desde el request.
RESEND_API_KEY=
# Remitente: siempre del dominio verificado de la plataforma (§8).
NOTIFICATIONS_FROM_ADDRESS=notificaciones@prendo.com.co
# Firma de los enlaces de baja de los correos al cliente (NOTIFICACIONES §17).
# Vacío = ningún correo al cliente sale (quedan `dead`: sin salida no se manda) y
# el endpoint público de baja rechaza todo token. Un valor largo y aleatorio
# (p. ej. `openssl rand -base64 48`), distinto por ambiente. Cambiarlo invalida
# los enlaces de los correos ya enviados: rotarlo solo si se filtró.
NOTIFICATIONS_LINK_SECRET=
# URL pública de ESTE backend, para la cabecera `List-Unsubscribe` de los correos
# al cliente (baja de un clic, RFC 8058 — NOTIFICACIONES §17-bis). En Fly no hace
# falta: vacía, se deriva de `FLY_APP_NAME` (https://<app>.fly.dev), que Fly pone
# sola en cada máquina, la del job incluida. Ponerla solo si el backend se sirve
# desde otro dominio. Sin ella y fuera de Fly, los correos salen sin esas cabeceras.
PUBLIC_API_URL=
